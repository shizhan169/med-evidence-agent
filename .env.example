# 填一个即可，优先 Qwen
QWEN_API_KEY=
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBED_MODEL=./models/bge-m3
# 重排模型用 ModelScope 下载到本地（bge-reranker-base，和 bge-m3 同一个 BGE 家族）：
#   modelscope download --model BAAI/bge-reranker-base --local_dir ./models/bge-reranker-base
RERANKER_MODEL=./models/bge-reranker-base
CHROMA_DIR=./data/chroma
PAPERS_DIR=./data/papers
# embedding 模型用 ModelScope 下载到本地（bge-m3 是多语言模型，中英文都支持）：
#   modelscope download --model BAAI/bge-m3 --local_dir ./models/bge-m3
# 换模型后必须删掉 data/chroma 重新跑 ingest（向量维度变了，旧库不能用）
# 国内下载 embedding 模型走镜像，否则首次运行可能下载失败或很慢
HF_ENDPOINT=https://hf-mirror.com
